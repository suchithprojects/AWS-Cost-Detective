# -------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# -------------------------------------------------------------------

# Use FAKE data so you can run with no AWS account at all.
# Set this to "false" only when you're ready to scan a real account.
USE_MOCK_DATA=true

# Your AWS keys. IMPORTANT: use a READ-ONLY user (see the README).
# Only needed when USE_MOCK_DATA=false.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional. If you add a key here, the AI will rewrite explanations to be
# friendlier. If you leave it blank, the tool uses built-in explanations
# and still works perfectly.
OPENAI_API_KEY=
